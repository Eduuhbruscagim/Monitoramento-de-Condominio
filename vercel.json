{
  "buildCommand": "echo 'No build needed - static site'",
  "outputDirectory": "src",
  "devCommand": "echo 'Dev server not configured'",
  "installCommand": "echo 'No dependencies to install'",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/about/sobre",
      "destination": "/about/sobre.html"
    },
    {
      "source": "/auth/login",
      "destination": "/auth/login.html"
    },
    {
      "source": "/auth/register",
      "destination": "/auth/register.html"
    },
    {
      "source": "/auth/forgot-password",
      "destination": "/auth/forgot-password.html"
    },
    {
      "source": "/dashboard/dashboard",
      "destination": "/dashboard/dashboard.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
